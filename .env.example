# =============================================================================
# ISET Tozeur Digital Observatory — Environment Configuration
# =============================================================================
# This is the ONLY .env file in the project.
# Docker Compose reads it automatically from the project root.
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/iset_db

# ── Authentication ──────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# JWT_EXPIRES_IN=24h

# ── Super Admin (seeded on first boot) ──────────────────────────────────────
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=change-me-in-production

# ── Groq AI (required for AI features — surveys, charts, reports) ───────────
GROQ_API_KEY=your-groq-api-key-here

# ── File Uploads ────────────────────────────────────────────────────────────
# Max upload size in bytes (default: 50 MB)
# UPLOAD_MAX_SIZE=52428800

# ── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# API URL injected into frontend at build time (only change if backend is on a different host)
# VITE_API_URL=http://localhost:4000

# ── SMTP (optional — for email notifications) ───────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-email-password
